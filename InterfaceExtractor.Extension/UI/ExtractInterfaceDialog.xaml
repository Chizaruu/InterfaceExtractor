<Window x:Class="InterfaceExtractor.UI.ExtractInterfaceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Extract Interface"
        Height="500" Width="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Padding" Value="5" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="15,5" />
            <Setter Property="Margin" Value="5,0" />
            <Setter Property="MinWidth" Value="80" />
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Class Name -->
        <TextBlock Grid.Row="0" Text="Extract interface from:" FontWeight="Bold" />
        <TextBlock Grid.Row="1" x:Name="ClassNameText" Text="ClassName" Margin="0,0,0,15" />

        <!-- Interface Name -->
        <TextBlock Grid.Row="2" Text="Interface name:" />
        <TextBox Grid.Row="3" x:Name="InterfaceNameTextBox" />

        <!-- Member Selection -->
        <GroupBox Grid.Row="4" Header="Select members to include in interface" Margin="0,0,0,15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Select All / None -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5">
                    <CheckBox x:Name="SelectAllCheckBox" Content="Select All"
                              Checked="SelectAllCheckBox_Changed"
                              Unchecked="SelectAllCheckBox_Changed"
                              Margin="0,0,15,0" />
                    <TextBlock Text="|" VerticalAlignment="Center" Margin="0,0,15,0" />
                    <Button Content="Select All" Click="SelectAll_Click" Padding="10,3" />
                    <Button Content="Deselect All" Click="DeselectAll_Click" Padding="10,3" />
                </StackPanel>

                <!-- Members List -->
                <ListBox Grid.Row="1" x:Name="MembersListBox"
                         SelectionMode="Single"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         Margin="5">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding DisplayText}"
                                      IsChecked="{Binding IsSelected}"
                                      Margin="0,5"
                                      FontFamily="Consolas" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </GroupBox>

        <!-- Buttons -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" IsDefault="True" Click="OK_Click" />
            <Button Content="Cancel" IsCancel="True" Click="Cancel_Click" />
        </StackPanel>
    </Grid>
</Window>